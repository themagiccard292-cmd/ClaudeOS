#!/usr/bin/env python3
"""claudeos-session-init: idempotent per-login setup. Never blocks login, always exits 0.

1. Ensure ~/.config/claudeos exists.
2. Best-effort start of the ydotoold user service.
3. Register the claudeos-desktop MCP server in Claude Code's user scope exactly once.

Overrides (tests): CLAUDEOS_CONFIG_DIR, CLAUDEOS_CLAUDE_JSON, CLAUDEOS_CLAUDE_BIN.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

SERVER = "claudeos-desktop"
COMMAND = "/usr/bin/claudeos-computer-control-mcp"
BUDGET_S = 9.0
STRIPPED_ENV = (
    "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL",
    "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY",
)
START = time.monotonic()


def remaining() -> float:
    return BUDGET_S - (time.monotonic() - START)


def run(cmd: list[str], timeout: float) -> int:
    env = {k: v for k, v in os.environ.items() if k not in STRIPPED_ENV}
    timeout = min(timeout, remaining())
    if timeout <= 0:
        return 124
    try:
        return subprocess.run(
            cmd, env=env, timeout=timeout, check=False,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode
    except (OSError, subprocess.SubprocessError):
        return 127


def find_claude() -> str | None:
    override = os.environ.get("CLAUDEOS_CLAUDE_BIN")
    if override:
        return override if os.access(override, os.X_OK) else None
    found = shutil.which("claude")
    if found:
        return found
    for p in ("/usr/local/bin/claude", "/usr/bin/claude"):
        if os.access(p, os.X_OK):
            return p
    return None


def registered_command(claude_json: Path) -> str | None:
    """Command of the user-scope server, or None if absent or unreadable."""
    try:
        data = json.loads(claude_json.read_text(encoding="utf-8"))
        return data["mcpServers"][SERVER]["command"]
    except (OSError, ValueError, KeyError, TypeError):
        return None


def main() -> int:
    config = Path(os.environ.get("CLAUDEOS_CONFIG_DIR") or Path.home() / ".config" / "claudeos")
    try:
        config.mkdir(parents=True, exist_ok=True)
    except OSError:
        pass

    if shutil.which("systemctl"):
        run(["systemctl", "--user", "--no-block", "start", "ydotoold.service"], 3)

    claude = find_claude()
    if claude is None:
        return 0
    claude_json = Path(os.environ.get("CLAUDEOS_CLAUDE_JSON") or Path.home() / ".claude.json")
    current = registered_command(claude_json)
    if current == COMMAND:
        return 0
    if current is not None:  # stale registration (older path)
        run([claude, "mcp", "remove", "--scope", "user", SERVER], 4)
    run([claude, "mcp", "add", "--scope", "user", SERVER, "--", COMMAND], 6)
    return 0


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 - login must never be blocked
        pass
    sys.exit(0)
