#!/usr/bin/env bash
# Terminal sign-in helper: sign in to Claude with your Claude subscription.
set -euo pipefail

find_claude() {
  if [ -n "${CLAUDEOS_CLAUDE_BIN:-}" ]; then echo "$CLAUDEOS_CLAUDE_BIN"; return; fi
  command -v claude 2>/dev/null || {
    for p in /usr/local/bin/claude /usr/bin/claude; do [ -x "$p" ] && { echo "$p"; return; }; done
  }
}

CLAUDE="$(find_claude || true)"
if [ -z "$CLAUDE" ]; then
  echo "Claude Code is not installed. Run: claudeos-update" >&2
  exit 1
fi

# Only the subscription sign-in path is used; provider overrides must not leak in.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
  CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY

cat <<'MSG'
Sign in to ClaudeOS
-------------------
ClaudeOS uses your Claude Pro or Max subscription.
A browser window will open (or a link will be printed). Sign in there,
then paste the code back here if you are asked for one.

MSG

status=0
"$CLAUDE" auth login --claudeai || status=$?

echo
if [ "$status" -ne 0 ]; then
  echo "Sign-in did not finish. You can try again with: claudeos-login"
  exit "$status"
fi
echo "Current status:"
"$CLAUDE" auth status --text || true
