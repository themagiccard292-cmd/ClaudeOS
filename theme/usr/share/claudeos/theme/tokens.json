{
  "name": "claudeos-theme",
  "version": 1,
  "light": {
    "background": "#F5F4EF",
    "surface": "#FFFFFF",
    "border": "#E6E4DD",
    "text": "#1F1E1D",
    "text-muted": "#6F6D66"
  },
  "dark": {
    "background": "#262624",
    "surface": "#1E1E1C",
    "border": "#383835",
    "text": "#ECEAE3",
    "text-muted": "#A5A39B"
  },
  "accent": "#D97757",
  "fonts": {
    "serif": "\"Newsreader\", \"Tiempos Text\", Georgia, serif",
    "sans": "\"Inter\", \"Styrene B\", system-ui, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, monospace"
  },
  "gnome": {
    "accent-color": "orange",
    "color-scheme": "default",
    "monospace-font-name": "JetBrains Mono 11",
    "picture-uri": "file:///usr/share/backgrounds/claudeos/claudeos-light.png",
    "picture-uri-dark": "file:///usr/share/backgrounds/claudeos/claudeos-dark.png"
  },
  "derived": {
    "on-accent": "#1F1E1D",
    "accent-text": {
      "light": "#B54C29",
      "dark": "#DF8B70"
